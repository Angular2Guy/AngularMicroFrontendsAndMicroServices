{
  "name": "payment",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build --configuration production",
    "build-nf": "ng build --configuration development",
    "build-stats": "ng build --configuration production --stats-json",
    "watch": "ng build --watch --configuration development",
    "analyse": "webpack-bundle-analyzer dist/manager/de/stats.json",
    "test": "ng test --watch=false --coverage",
    "test-local": "ng test --watch=true",
    "prebuild": "rimraf ./dist && mkdirp ./dist",
    "postbuild": "npm run deploy",
    "predeploy": "rimraf ../../../paymnet-backend/src/main/resources/static/*",
    "deploy": "cpy 'dist/payment/browser/**' '../../../payment-backend/src/main/resources/static/'",
    "prettier": "npx prettier --write 'src/**/*.{ts,html,scss,json}'"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.1",
    "@angular/cdk": "^22.0.1",
    "@angular/common": "^22.0.1",
    "@angular/compiler": "^22.0.1",
    "@angular/core": "^22.0.1",
    "@angular/forms": "^22.0.1",
    "@angular/platform-browser": "^22.0.1",
    "@angular/platform-browser-dynamic": "^22.0.1",
    "@angular/router": "^22.0.1",
    "@angular/material": "^22.0.1",
    "@jsverse/transloco": "^7.5.0",
    "@jsverse/transloco-locale": "^7.0.1",
    "es-module-shims": "^1.5.12",
    "luxon": "^3.4.0",
    "material-icons": "^1.13.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.1",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.0.1",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.12",
    "cpy-cli": "^4.2.0",
    "jsdom": "^31.0.1",
    "mkdirp": "^1.0.4",
    "prettier": "^3.0.0",
    "replace-in-file": "^8.2.0",
    "rimraf": "^5.0.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12",
    "webpack-bundle-analyzer": "^4.5.0"
  }
}
